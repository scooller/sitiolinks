RewriteEngine On
RewriteBase /

# Tipos MIME para archivos de LLMs y Sitemaps
AddType text/plain;charset=UTF-8 .txt
AddType application/xml;charset=UTF-8 .xml

# Cabeceras de control de caché para evitar caché de HTML y Service Worker en Hostinger / LiteSpeed
<IfModule mod_headers.c>
    # index.html, service worker y manifest NUNCA se cachean (garantiza CSS y JS nuevos en cada subida)
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Archivos de LLM SEO, robots y sitemaps (actualización fresca cada 1 hora)
    <FilesMatch "^(llms\.txt|llms-full\.txt|robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Archivos con hash de Vite (CSS, JS, fuentes, imágenes) tienen caché largo e inmutable
    <FilesMatch "\.(css|js|woff2?|ttf|svg|webp|png|jpg|jpeg|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Redirigir rastreadores de redes sociales al endpoint de Open Graph para previsualización de perfiles
RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|Discordbot|LinkedInBot|Slackbot) [NC]
RewriteRule ^u/([^/]+)/?$ https://admin.only-models.online/api/og/user/$1 [R=302,L]

# No rewrite for existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback all other requests to index.html for SPA routing
RewriteRule ^ index.html [L]
