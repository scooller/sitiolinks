RewriteEngine On
RewriteBase /

# Cabeceras de control de caché para evitar caché de HTML y Service Worker en Hostinger / LiteSpeed
<IfModule mod_headers.c>
    # index.html, service worker y manifest NUNCA se cachean (garantiza CSS y JS nuevos en cada subida)
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Archivos con hash de Vite (CSS, JS, fuentes, imágenes) tienen caché largo e inmutable
    <FilesMatch "\.(css|js|woff2?|ttf|svg|webp|png|jpg|jpeg|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# No rewrite for existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback all other requests to index.html for SPA routing
RewriteRule ^ index.html [L]
